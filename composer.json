{
    "name": "kinetistack-io/php-sdk",
    "description": "Framework-Agnostic PHP Client Library for KinetiStack API",
    "type": "library",
    "keywords": ["kinetistack", "api", "sdk", "client"],
    "license": "MIT",
    "authors": [
        {
            "name": "KinetiStack",
            "email": "support@kinetistack.io"
        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/http-client": "^6.4 || ^7.0",
        "symfony/http-client-contracts": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.60",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5 || ^11.3"
    },
    "autoload": {
        "psr-4": {
            "KinetiStack\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KinetiStack\\Sdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.1.0"
        }
    }
}

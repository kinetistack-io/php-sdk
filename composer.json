{
    "name": "kinetistack-io/php-sdk",
    "description": "Framework-Agnostic PHP Client Library for KinetiStack API",
    "type": "library",
    "keywords": ["kinetistack", "api", "sdk", "client"],
    "license": "MIT",
    "authors": [
        {
            "name": "KinetiStack",
            "email": "support@kinetistack.io"
        }
    ],
    "homepage": "https://kinetistack.io",
    "readme": "README.md",
    "support": {
        "issues": "https://github.com/kinetistack-io/php-sdk/issues",
        "source": "https://github.com/kinetistack-io/php-sdk",
        "docs": "https://kinetistack.io/docs"
    },
    "require": {
        "php": ">=8.1",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0 || ^2.0"
    },
    "suggest": {
        "symfony/http-client": "To use Symfony's HTTP Client (^6.4 || ^7.0)",
        "guzzlehttp/guzzle": "To use Guzzle HTTP Client (^7.8)"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.60",
        "guzzlehttp/guzzle": "^7.8",
        "guzzlehttp/psr7": "^2.6",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5 || ^11.3",
        "symfony/http-client": "^6.4 || ^7.0",
        "symfony/http-client-contracts": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "KinetiStack\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KinetiStack\\Sdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.1.0"
        }
    },
    "version": "1.0.1"
}
